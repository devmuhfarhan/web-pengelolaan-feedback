# ============================================
# BACKEND ENVIRONMENT VARIABLES - PUSPADI BALI
# ============================================
# Copy file ini menjadi .env dan isi sesuai konfigurasi server

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_pengelolaan_feedback
DB_USER=root
DB_PASSWORD=root

# CORS - URL frontend yang diizinkan (pisahkan dengan koma jika lebih dari satu)
# Contoh production: CORS_ALLOWED_ORIGINS=https://portal.puspadibali.org
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Django Secret Key - GANTI dengan string acak yang panjang di production!
# Generate di: https://djecrety.ir/
SECRET_KEY=django-insecure-ganti-dengan-key-yang-aman-di-production
